# ---------------------------------------------------------------------------
# Example environment file for the NodeGoat DevSecOps stack.
#
#   cp .env.example .env
#
# This file is COMMITTED and documents which variables exist and what they are
# for. It must never contain real values.
#
# .env is git-ignored and must never be committed. See docs/secrets.md.
#
# The stack runs WITHOUT a .env file: every non-secret setting below has a
# default in docker-compose.yml, and every secret falls back to a randomly
# generated per-process value rather than to a hardcoded literal.
# ---------------------------------------------------------------------------


# ===========================================================================
# SECRETS
#
# These have NO default in docker-compose.yml, deliberately. A default secret
# committed to the repository is precisely the problem this phase removes.
#
# If a variable below is unset, the application generates a random value for
# that process and logs a warning. The application still starts; it simply
# cannot be predictable. The trade-off is that sessions do not survive a
# container restart until you set a stable value here.
#
# Generate a value with:
#   openssl rand -hex 32
#   # or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

# Signing key for express-session cookies (consumed at server.js:82).
# If this is predictable, session cookies can be forged and sessions hijacked.
# Must differ between environments and must never be committed.
SESSION_SECRET=

# Key for AES encryption of profile data (SSN, date of birth).
# NOTE: currently INERT. The code that consumes it is commented out in
# app/data/profile-dao.js (the disabled "Fix for A6"), so setting this changes
# nothing today. It is provisioned here so that enabling that fix does not
# require reintroducing a hardcoded key.
CRYPTO_KEY=


# ===========================================================================
# HASHICORP VAULT (optional demonstration)
#
# When VAULT_DEV_ROOT_TOKEN is set, the stack starts a local Vault container,
# provisions AppRole authentication, GENERATES the application secrets inside
# Vault, and the application fetches them at startup. SESSION_SECRET and
# CRYPTO_KEY above are then unnecessary - leave them blank.
#
# When it is unset, Vault provisioning is skipped entirely and the values above
# are used. Vault is additive and never blocks the stack from starting.
#
# SECRET ZERO: this token is the credential needed to bootstrap Vault itself.
# Vault cannot eliminate it; production breaks the chain with platform identity
# (Kubernetes service accounts, cloud IAM, KMS auto-unseal) instead of a shared
# token. Documented, not hidden - see docs/secrets.md.
#
# Dev mode only. Generate any value, e.g.:
#   echo "dev-root-$(openssl rand -hex 12)"
VAULT_DEV_ROOT_TOKEN=

# Vault image tag.
VAULT_IMAGE_TAG=2.1.0


# ===========================================================================
# APPLICATION (non-secret)
# ===========================================================================

# development | production
# `development` injects a livereload <script> tag (config/env/development.js)
# that points at a port nothing serves, so production is the sane default.
NODE_ENV=production

# Host interface the app is published on.
# 127.0.0.1 = this machine only (default, and strongly recommended: NodeGoat is
#             deliberately vulnerable).
# 0.0.0.0   = reachable by every host on your network. Only set this if you
#             genuinely need it, and understand what you are exposing.
APP_BIND_ADDRESS=127.0.0.1

# Host port. Change if 4000 is already in use on your machine.
APP_PORT=4000


# ===========================================================================
# DATABASE (non-secret)
#
# MongoDB runs unauthenticated and is not published to the host - it is
# reachable only from the app over the private compose network (trust boundary
# TB-2 in docs/architecture.md). There is therefore no database credential to
# provision here. If authentication is enabled later, the username and password
# belong in the SECRETS section above, not here.
# ===========================================================================

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=nodegoat
MONGO_IMAGE_TAG=4.4


# ===========================================================================
# NOT PROVISIONED HERE - deliberately left hardcoded
#
# The following remain in source, with reasons. See docs/secrets.md for the
# full inventory and justification.
#
#   config/env/development.js:6   zapApiKey  - OWASP ZAP API key. Tooling only,
#   config/env/test.js:6          zapApiKey    for a test suite that cannot run
#                                              (needs a ZAP proxy at a hardcoded
#                                              192.168.56.20). Retained as the
#                                              demonstration finding for the
#                                              Gitleaks gate; baselined by exact
#                                              fingerprint in .gitleaksignore.
#
#   artifacts/db-reset.js:18,27,35   Seeded demo account passwords. Published
#                                    upstream, documented in README.md, and
#                                    relied on by scripts/smoke-test.sh.
#
#   app/views/tutorial/a2.html:153   Documentation code samples, not config.
#   app/views/tutorial/a3.html:176
# ===========================================================================
