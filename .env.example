# ---------------------------------------------------------------------------
# Example environment file for the NodeGoat DevSecOps stack.
#
#   cp .env.example .env
#
# The stack runs WITHOUT a .env file - docker-compose.yml supplies a default for
# every variable below. Copy this file only if you need to override something.
#
# .env is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
# `development` injects a livereload <script> tag (config/env/development.js)
# that points at a port nothing serves, so production is the sane default.
NODE_ENV=production

# Host interface the app is published on.
# 127.0.0.1 = this machine only (default, and strongly recommended: NodeGoat is
#             deliberately vulnerable).
# 0.0.0.0   = reachable by every host on your network. Only set this if you
#             genuinely need it, and understand what you are exposing.
APP_BIND_ADDRESS=127.0.0.1

# Host port. Change if 4000 is already in use on your machine.
APP_PORT=4000

# --- Database --------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=nodegoat
MONGO_IMAGE_TAG=4.4

# ---------------------------------------------------------------------------
# NOT YET MANAGED HERE (phase 1 scope)
#
# NodeGoat ships hardcoded secrets that are deliberately left in place for now
# so they can serve as findings for the secrets-scanning gate in a later phase:
#
#   config/env/all.js:8          cookieSecret
#   config/env/all.js:9          cryptoKey
#   config/env/development.js:6  zapApiKey
#   config/env/test.js:6         zapApiKey
#   artifacts/db-reset.js:18,27,35   seeded account passwords
#
# See docs/architecture.md for the options under consideration.
# ---------------------------------------------------------------------------
